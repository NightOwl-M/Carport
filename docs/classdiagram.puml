'Entitetsrelationer'
Customer o-- Order
Order *-- Customer
MaterialVariant *-- Material
Customer *-- Zipcode
Component *-- MaterialVariant
Order *-- OrderStatus




@enduml
Customer "1" --> "0..*" Order
MaterialVariant "1" --> "1" Material
Customer "1" --> "1" Zipcode
Component "1" --> "1" MaterialVariant
Order "1" --> "0..*" Component
Order "1" --> "1" OrderStatus
1:1 → "1" --> "1"

1:mange → "1" --> "0..*"

mange:1 → "* " --> "1"

evt. 0 → "0..1" eller "0..*"


implements ..|>
extends <|-- (is-a)
composition *-- (must-have)
Aggregation o-- (can-have)
Associering <--
